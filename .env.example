KAFKA_EXTERNAL_PORT=9092

CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=metrics
CLICKHOUSE_USER=metrics
CLICKHOUSE_PASSWORD=change-me

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

KAFKA_UI_PORT=8080
SPARK_DRIVER_MEMORY=1g

# Host collector settings. launchd loads this file through its wrapper.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SECURITY_EVENTS_TOPIC=security_events
COLLECTION_INTERVAL_SECONDS=5
KAFKA_CLIENT_ID=security-telemetry-collector
HOST_ID_SALT=replace-with-a-private-stable-local-value
DOCKER_EVENTS_ENABLED=true
LOG_LEVEL=INFO
